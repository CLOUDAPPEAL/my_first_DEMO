/* pages/index/index.wxss */
.container {
  display: flex;
  flex-direction: column;
  padding: 10px;
  box-sizing: border-box;
  align-items: center; /* 使子元素水平居中 */
}

.upload-area {
  width: 100%;
  margin-bottom: 20px;
  display: flex;
  flex-direction: column;
  align-items: center; /* 使子元素水平居中 */
}

.upload-title {
  background-color: rgb(0, 255, 136);
  font-size: 18px;
  color: #000000;
  margin-bottom: 10px;
}

.image-list {
  display: flex;
  flex-wrap: wrap;
  margin: -5px;
}

.image-item {
  width: 100px;
  height: 100px;
  margin: 5px;
  position: relative;
  border-radius: 4px;
  overflow: hidden;
  background-color: #f5f5f5;
}

.image-item image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.add-btn {
  display: flex;
  justify-content: center;
  align-items: center;
  border: 1px dashed #ddd;
}

.delete-icon {
  position: absolute;
  top: 0;
  right: 0;
  color: #fff;
  background-color: rgba(0, 0, 0, 0.5);
  border-radius: 0 0 0 10px;
  padding: 2px;
}

.submit-btn {
  margin-top: 20px;
  background-color: #02b659;
  color: rgb(255, 255, 255);
}

.submit-btn[disabled] {
  background-color: #a2a9b0;
  opacity: 0.6;
}

/* Recording indicator style */

.recording-indicator {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin: 20px 0;
}
